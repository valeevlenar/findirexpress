# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в git не попадает (см. .gitignore).

# Токены telegram-ботов (@BotFather)
TOKEN=
ADMINBOTTOKEN=
SUPPORTBOTTOKEN=

# Telegram id администратора (получит уведомления об ошибках и админ-отчеты)
ADMIN_ID=

# WB API токен по умолчанию (используется в разовых dev-скриптах; у каждого продавца свой ключ хранится в БД)
wb_api_token=

# Пароль приложения для почты, с которой отправляются письма (SMTP, см. config.py)
yandex_password=

# Строка подключения к БД (async, SQLAlchemy + asyncpg)
DBURL=postgresql+asyncpg://user:password@localhost:5432/findirexpress

# Прокси для aiogram-сессий ботов (необязательно)
#PROXY_URL=socks5://127.0.0.1:1080

# --- Интеграция с банком Точка (счета/закрывающие документы) ---
# Не обязательна: если оставить пустыми, функции в app/payments/bank.py
# просто пропускают вызов и логируют, что интеграция отключена.
JWTTOKEN=
BANK_ACCOUNT_ID=
BANK_CUSTOMER_CODE=
COMPANY_INN=
BANK_CLIENT_ID=
